{
  "name": "ixasales",
  "version": "1.0.0",
  "description": "Distribution ERP - Multi-tenant SaaS",
  "scripts": {
    "dev": "tsx watch src/index-fastify.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index-fastify.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-all": "tsx src/db/seed-simple.ts",
    "db:reset-seed:local:full": "tsx src/db/reset-seed-local-full.ts",
    "db:view": "tsx src/db/view-data.ts",
    "db:studio": "drizzle-kit studio",
    "db:enhance-visits": "tsx src/db/enhance_visits_migration.ts",
    "db:migrate:tenant-integrations": "tsx src/db/migrations/add_tenant_integrations.ts",
    "db:reencrypt:tenant-integrations": "tsx src/db/migrations/reencrypt_tenant_integrations.ts",
    "db:backfill:telegram-bot-usernames": "tsx src/db/migrations/backfill_telegram_bot_usernames.ts",
    "backup:manifests:backfill": "tsx scripts/backfill-backup-manifests.ts --max-files 500",
    "backup:verify": "tsx scripts/verify-backups.ts --max-files 5",
    "backup:verify:drill": "tsx scripts/verify-backups.ts --max-files 1 --drill",
    "backup:verify:fresh": "tsx scripts/verify-backups.ts --max-files 5 --max-age-hours 24",
    "scheduler:run": "tsx scripts/run-scheduler-jobs.ts",
    "scheduler:backup-verify": "tsx scripts/run-scheduler-jobs.ts --job backup-verify",
    "scheduler:backup-verify:tenant": "tsx scripts/run-scheduler-jobs.ts --job backup-verify-tenant",
    "scheduler:backup-verify:drill-nightly": "tsx scripts/run-scheduler-jobs.ts --job backup-verify-drill-nightly",
    "scheduler:backup-verification-tick": "tsx scripts/run-scheduler-jobs.ts --backup-verification-tick",
    "smoke:telegram:webhook-secret": "tsx scripts/smoke-telegram-webhook-secret.ts",
    "deploy:staging": "powershell -ExecutionPolicy Bypass -File scripts/deploy-staging.ps1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "node --test \"src/__tests__/**/*.test.js\" \"tests/**/*.test.js\"",
    "test:customer-portal:integration": "node --test tests/customer-portal-auth.integration.test.js",
    "test:order:integration": "node --test tests/order-idempotency-integration.test.js",
    "test:backup": "npx vitest run src/__tests__/backup-tenant-file-integrity.test.ts src/__tests__/tenant-backup-restore.test.ts src/__tests__/tenant-backup-extract-scope.test.ts src/__tests__/backup-full-verify.test.ts",
    "test:payroll": "npx vitest run src/__tests__/payroll --reporter=verbose",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@sinclair/typebox": "^0.34.47",
    "@types/bcryptjs": "^2.4.6",
    "@types/cron": "^2.4.3",
    "@types/nodemailer": "^7.0.5",
    "bcryptjs": "^3.0.3",
    "cron": "^4.4.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.35.0",
    "fastify": "^5.7.1",
    "fastify-plugin": "^5.1.0",
    "form-data": "^4.0.5",
    "ioredis": "^5.9.2",
    "jose": "^6.1.3",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.15.0",
    "pg": "^8.17.2",
    "postgres": "^3.4.5",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "drizzle-kit": "^0.26.0",
    "eslint": "^9.39.0",
    "globals": "^17.1.0",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.20.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.53.1"
  }
}
