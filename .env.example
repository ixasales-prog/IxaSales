# ==============================================================================
# IXASALES ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your values

# ==============================================================================
# DATABASE
# ==============================================================================
DATABASE_URL=postgres://user:password@localhost:5432/ixasales

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
# JWT Secret - MUST be at least 32 characters for security
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ==============================================================================
# APP CONFIGURATION
# ==============================================================================
PORT=3000
NODE_ENV=development
# For production: NODE_ENV=production
API_URL=https://api.ixasales.com
# For development: comma-separated list of allowed origins
# For production: must be explicitly set to prevent security vulnerabilities
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ==============================================================================
# REDIS (for production rate limiting)
# ==============================================================================
# If not set, falls back to in-memory rate limiting (not recommended for production)
# REDIS_URL=redis://localhost:6379

# ==============================================================================
# TELEGRAM BOT
# ==============================================================================
# These are fallback values - can also be configured via admin UI
# and stored in database for persistence
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Note: Tenant-specific bot tokens are stored in the tenants table
# and configured through the tenant admin interface

# Integration secrets encryption key (recommended in all environments)
# Generate with: openssl rand -hex 32
INTEGRATIONS_ENCRYPTION_KEY=

# ==============================================================================
# PUSH NOTIFICATIONS (Web Push)
# ==============================================================================
# Generate VAPID keys with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourcompany.com

# ==============================================================================
# WEATHER API (OpenWeatherMap)
# ==============================================================================
# Optional: Global fallback API key for weather widget
# Each tenant can also configure their own key in Business Settings
# OPENWEATHER_API_KEY=your_api_key_here

# ==============================================================================
# PAYMENT GATEWAYS
# ==============================================================================
# Click Payment
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=

# Payme Payment
# PAYME_MERCHANT_ID=
# PAYME_SECRET_KEY=

# ==============================================================================
# FILE STORAGE
# ==============================================================================
STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ==============================================================================
# BACKUP / RESTORE
# ==============================================================================
# Backup format: sql (plain SQL) or custom (pg_dump custom format)
# BACKUP_FORMAT=sql
# Optional explicit executable paths
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# PSQL_PATH=C:\Program Files\PostgreSQL\17\bin\psql.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
# Optional timeouts in milliseconds
# BACKUP_PROCESS_TIMEOUT_MS=600000
# RESTORE_PROCESS_TIMEOUT_MS=1800000
# Pre-drop drizzle schema before SQL restore (helps older SQL dumps restore cleanly)
# BACKUP_RESTORE_PRE_DROP_DRIZZLE=true
# Verification timeout (checksum+drill command timeout)
# BACKUP_VERIFY_TIMEOUT_MS=1800000
# Max files checked when no filename is provided
# BACKUP_VERIFY_MAX_FILES=5
# Optional freshness SLO: fail verification if newest backup older than N hours (0 disables)
# BACKUP_VERIFY_MAX_AGE_HOURS=24
# Require checksum manifest to exist during restore/verification
# Default is true; set to false only while migrating legacy backups without manifests.
# BACKUP_REQUIRE_MANIFEST=true
# Enable restore drill during verification (must point to disposable DB)
# BACKUP_VERIFY_RESTORE_DRILL=false
# Dedicated disposable database URL for restore drill verification
# BACKUP_VERIFY_DATABASE_URL=postgres://user:password@localhost:5432/ixasales_backup_verify
# Nightly restore-drill schedule (cron, default 02:15 UTC)
# BACKUP_VERIFY_DRILL_CRON=15 2 * * *
# BACKUP_VERIFY_DRILL_TIMEZONE=UTC
# Number of newest backups to drill each run (default 1)
# BACKUP_VERIFY_DRILL_MAX_FILES=1
# Preferred post-backup hook command for offsite sync (safe JSON argv, no shell)
# Placeholders: {filename}, {file}, {manifest}
# BACKUP_POST_COMMAND_JSON=["aws","s3","cp","{file}","s3://my-locked-backups/{filename}","--checksum-algorithm","SHA256","--metadata","manifest={manifest}"]
# BACKUP_POST_COMMAND_JSON=["aws","s3","cp","{manifest}","s3://my-locked-backups/{filename}.meta.json"]
# Legacy plain command string (less safe, still supported):
# Example (S3 Object Lock bucket):
# BACKUP_POST_COMMAND=aws s3 cp "{file}" "s3://my-locked-backups/{filename}" --checksum-algorithm SHA256 --metadata manifest="{manifest}"
# Then upload manifest, too:
# BACKUP_POST_COMMAND=aws s3 cp "{manifest}" "s3://my-locked-backups/{filename}.meta.json"
# BACKUP_POST_COMMAND=rclone copy "{file}" remote:ixasales-backups/
# If true, backup fails when post-backup command fails
# BACKUP_POST_COMMAND_REQUIRED=false
# Backup policy guardrails
# Require offsite replication (defaults to true in production, false in non-production)
# BACKUP_REQUIRE_OFFSITE=true
# Explicitly allow local-only backups even when offsite is required
# BACKUP_ALLOW_LOCAL_ONLY=false
# Offsite health evidence (at least one of these should be configured when offsite is required)
# Option A: proof file updated by your replication pipeline
# BACKUP_OFFSITE_PROOF_PATH=/var/lib/ixasales/backup-offsite.ok
# BACKUP_OFFSITE_MAX_AGE_HOURS=24
# Option B: command that exits 0 only when offsite backup target is healthy
# BACKUP_OFFSITE_HEALTHCHECK_COMMAND_JSON=["aws","s3","ls","s3://my-locked-backups/"]
# BACKUP_OFFSITE_HEALTHCHECK_TIMEOUT_MS=30000
# Require PITR policy (defaults to true in production, false in non-production)
# BACKUP_REQUIRE_PITR=true
# Set true only when WAL archiving/PITR is configured externally
# BACKUP_PITR_ENABLED=false
# Maximum allowed lag for last archived WAL (minutes) during PITR health checks
# BACKUP_PITR_MAX_ARCHIVE_LAG_MINUTES=60
# Auto-generate full tenant snapshots after each successful full backup
# BACKUP_CREATE_TENANT_SNAPSHOTS=true
# Snapshot format for auto-generated tenant backups: json or sql
# BACKUP_TENANT_SNAPSHOT_FORMAT=json
# Include only active tenants while generating auto snapshots
# BACKUP_TENANT_SNAPSHOT_ACTIVE_ONLY=true
# If true, full backup operation fails when any tenant snapshot fails
# BACKUP_TENANT_SNAPSHOT_REQUIRED=false
# Retention window for tenant snapshots (defaults to backup.retentionDays when unset)
# BACKUP_TENANT_SNAPSHOT_RETENTION_DAYS=30

# ==============================================================================
# SECURITY (PRODUCTION)
# ==============================================================================
# Set to 'true' to disable HTTPS redirect (not recommended)
# DISABLE_HTTPS_REDIRECT=false

# ==============================================================================
# LOGGING
# ==============================================================================
# Log level: debug, info, warn, error
# LOG_LEVEL=info

